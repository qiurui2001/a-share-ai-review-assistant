# ── A股AI投资复盘助手 环境变量模板 ──
# 复制为 .env 并填入自己的配置

# ── DeepSeek（OpenAI 兼容） ──
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=16384

# ── 邮件交付（QQ 邮箱示例，SMTP_PASS 为授权码而非登录密码） ──
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your@qq.com
SMTP_PASS=你的SMTP授权码
FROM_EMAIL=your@qq.com
REPORT_TO_EMAIL=client@example.com

# ── Agent 行为 ──
AGENT_VERBOSE=true
CREWAI_TRACING_ENABLED=false
HTTP_TIMEOUT=20
# 空响应自动重试：次数与每次退避基数（秒）
LLM_EMPTY_RETRY=3
LLM_RETRY_DELAY=2
REPORT_DIR=reports
OUTPUT_DIR=outputs

# ── 模拟交易 ──
PAPER_INITIAL_CASH=100000
PAPER_DIR=paper
